import os
from pathlib import Path
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from PIL import Image

DATA_DIR = Path("/content/drive/MyDrive/PlantDiseaseProject/PlantVillage")
IMAGE_EXTS = {".jpg", ".jpeg", ".png", ".bmp", ".webp"}

records = []
if DATA_DIR.exists():
    with os.scandir(DATA_DIR) as entries:
        for entry in entries:
            if entry.is_dir():
                cls_name = entry.name
                with os.scandir(entry.path) as files:
                    for f in files:
                        if f.is_file() and Path(f.name).suffix.lower() in IMAGE_EXTS:
                            records.append({
                                "path": f.path,
                                "class_name": cls_name,
                                "file_size_kb": round(f.stat().st_size / 1024, 2),
                            })

df = pd.DataFrame(records)
print(f"Total images found: {len(df)}")
print(f"Total classes found: {df['class_name'].nunique() if not df.empty else 0}")

if not df.empty:
    class_counts = df["class_name"].value_counts()
    imbalance_ratio = class_counts.iloc[0] / class_counts.iloc[-1]
    print(f"Max / Min class count ratio: {imbalance_ratio:.2f}x")
    print("\nTop 5 classes:\n", class_counts.head(5))
    print("\nBottom 5 classes:\n", class_counts.tail(5))

    sample_df = df.sample(n=min(300, len(df)), random_state=42)
    sizes, modes, corrupt_sample = [], [], []
    for p in sample_df["path"]:
        try:
            with Image.open(p) as img:
                sizes.append(img.size)
                modes.append(img.mode)
        except Exception as e:
            corrupt_sample.append((p, str(e)))

    print(f"\nSampled {len(sample_df)} images | Corrupt in sample: {len(corrupt_sample)}")
    print("Sample color modes:", pd.Series(modes).value_counts().to_dict())
    print("Top image sizes (w, h) in sample:", pd.Series(sizes).value_counts().head(5).to_dict())

    dup_candidates = int(df.duplicated(subset=["class_name", "file_size_kb"], keep=False).sum())
    print(f"Potential duplicate candidates (same class & file size): {dup_candidates}")

    plt.figure(figsize=(14, 5))
    class_counts.plot(kind="bar")
    plt.title("PlantVillage Class Distribution")
    plt.xlabel("Class Name")
    plt.ylabel("Number of Images")
    plt.xticks(rotation=90, fontsize=8)
    plt.tight_layout()
    plt.show()

    sample_classes = df["class_name"].drop_duplicates().sample(n=min(6, df["class_name"].nunique()), random_state=42)
    fig, axes = plt.subplots(2, 3, figsize=(12, 8))
    axes = axes.flatten()
    for ax, cls in zip(axes, sample_classes):
        img_path = df[df["class_name"] == cls].iloc[0]["path"]
        with Image.open(img_path) as img:
            ax.imshow(img.convert("RGB"))
        ax.set_title(cls[:28], fontsize=9)
        ax.axis("off")
    for ax in axes[len(sample_classes):]:
        ax.axis("off")
    plt.tight_layout()
    plt.show()
